<?xml version="1.0" encoding="utf-8"?>
<!-- Single-Activity wrapper: adding a SplashActivity would insert the exact
     blank frame this project exists to remove. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Needed only so the WebView can check connectivity, not for the app itself. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="Everything"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:theme="@style/Theme.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Replaces the PWA manifest shortcuts (./?capture=1, ./?view=...):
                 VIEW intents land in onNewIntent() and are forwarded to the WebView. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="everything-app-zeta.vercel.app" />
            </intent-filter>
        </activity>
    </application>
</manifest>

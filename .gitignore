node_modules/
.env
.env.*
!.env.example
# Playwright's local browser profile. It holds a real Supabase session, so it must never be
# committed. Screenshots from browser checks are build artefacts, not source.
.browser-profile/
*.png
# Scratch files from browser checks and commit messages. These are local tooling, not source, and a
# `git add -A` should never be able to sweep one into a commit.
tmp-*
shot-*.png

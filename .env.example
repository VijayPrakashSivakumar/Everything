# ---------------------------------------------------------------------------
# Everything - environment template
# ---------------------------------------------------------------------------
#
# Copy this file to `.env` and fill in the real values. `.env` is already in
# .gitignore and must never be committed; this file is the documented shape of
# one, and is the only version that belongs in Git.
#
#   cp .env.example .env
#
# The frontend cannot read these. Vercel injects them into the serverless
# functions in Everything/api/ at runtime, via Project Settings > Environment
# Variables. Anything marked PUBLIC below is the exception: it is compiled into
# script.js and is visible to anyone who opens the page, so it is never a
# secret and is safe to expose. That is the whole reason the two groups below
# are separated - see the note above SERVER.
#
# Nothing here is required to run the UI. The app is offline-first: captures,
# tasks and notes are written to local storage and work with no server at all.
# A missing value degrades one feature; it does not break the app.
# ---------------------------------------------------------------------------


# === SERVER (secret - never sent to the browser) ===========================
#
# These are read by Everything/api/*.js through process.env. A leaked
# SUPABASE_SERVICE_ROLE_KEY bypasses every row-level security policy in the
# database, so treat it like a password: Vercel only, never in a file.


# Project URL. Supabase > Project Settings > Data API.
# Replaceable: when the database is self-hosted this becomes the PostgREST
# base URL instead, and nothing else in the code changes.
SUPABASE_URL=https://your-project-ref.supabase.co

# "service_role" key. Server only. BYPASSES all RLS policies - never expose it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# "anon" key. Safe to publish, and the only one the browser ever sees. All
# real access control is enforced by the RLS policies in supabase/migrations/.
SUPABASE_ANON_KEY=your-anon-key


# === WEB PUSH (server secret + one public key) ============================
#
# Notification delivery. The service worker (sw.js) needs the public key in
# the browser; the private key signs the payloads and must stay on the server.
# Generate a pair with:  node Everything/scripts/check-vapid.mjs


# Public application server key. Safe to publish - handed to every browser.
VAPID_PUBLIC_KEY=

# Private application server key. SECRET. Signs every push payload.
VAPID_PRIVATE_KEY=

# Contact address for push, in mailto: form. Shown by browsers on push prompts.
VAPID_SUBJECT=mailto:you@example.com


# === AI PROVIDER (optional - Ask and smart capture) ========================
#
# The adapter in Everything/api/ask.js picks a provider per request and falls
# back to the next one on a rate limit or server error, so having two keys set
# makes Ask noticeably more reliable. Free tiers are the usual choice here.
#
# AI_PROVIDER pins the PRIMARY only; the others are still used as fallbacks.
# Leave it unset to auto-detect from whichever keys are present.


# Optional. One of: gemini | groq | openai | openrouter | anthropic
AI_PROVIDER=

# Gemini. Largest free token allowance, and the same model smart capture uses.
GEMINI_API_KEY=
# Optional override. Default: gemini-flash-latest
GEMINI_MODEL=

# Groq. Free gpt-oss-120b, but limited to 8K input tokens/minute, so request
# size and volume are bounded rather than assumed.
GROQ_API_KEY=
# Optional override. Default: openai/gpt-oss-120b
GROQ_MODEL=

# OpenAI. Any OpenAI-compatible endpoint works via OPENAI_BASE_URL, which is
# how a local model server is wired in.
OPENAI_API_KEY=
# Optional override. Default: gpt-4o-mini
OPENAI_MODEL=
# Optional. Point at a self-hosted server (e.g. http://127.0.0.1:11434/v1).
OPENAI_BASE_URL=

# OpenRouter. Aggregates many models behind one key.
OPENROUTER_API_KEY=
# Optional override. Default: openrouter/free
OPENROUTER_MODEL=

# Anthropic.
ANTHROPIC_API_KEY=
# Optional override. Default: claude-sonnet-4-6
ANTHROPIC_MODEL=


# === REMINDER SCHEDULER (optional) =========================================
#
# Read by Everything/api/send-due-notifications.js, run on a schedule (see
# supabase/reminder-cron.sql). Without a scheduler these stay unset and no
# reminders are sent; the in-app list still works.


# Shared secret the cron endpoint requires in its Authorization header. Set it
# to a long random string. An unset or guessable value means anyone who learns
# the URL can trigger your notification queue.
CRON_SECRET=

# IANA timezone, e.g. Europe/London. "8am" has to mean 8am where the user is.
REMINDER_TIMEZONE=Europe/London

# Look-back window in minutes. Caps how far back a single run will look, so a
# scheduler that was down for hours does not fire a large backlog at once.
REMINDER_LOOKBACK_MINUTES=60

# Hard cap on reminders sent per run. Protects a push provider's rate limit.
REMINDER_MAX_PER_RUN=50


# === RUNTIME (optional) ====================================================

# development | production. Production omits verbose logging.
NODE_ENV=development